# -----------------------------------------------------------------------------
# TalentBridge Environment Variables Example
# Duplicate this file as .env and update values for your environment.
# Never commit .env to version control!
# -----------------------------------------------------------------------------

# Django Core Settings
DJANGO_SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL for Production, SQLite supported for local dev)
# Example PostgreSQL: postgres://talent_user:talent_password@localhost:5432/talentbridge_db
DATABASE_URL=sqlite:///db.sqlite3

# Security (Production settings)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Front-End and Domain Settings
FRONTEND_URL=http://localhost:8000
PRODUCTION_DOMAIN=talentbridge.example.com

# File Storage Configuration
RESUME_STORAGE_DIR=./private_media/resumes
MAX_RESUME_SIZE_MB=5

# Email Service Credentials
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TalentBridge <noreply@talentbridge.com>

# Connection Pooling
CONN_MAX_AGE=0

# Docker production stack; replace this value before starting
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
REDIS_URL=redis://redis:6379/1
CSRF_TRUSTED_ORIGINS=https://your-production-domain.example
AUTH_RATE_LIMIT=30

# Neon: neon deploy writes these into the ignored .env; never paste real values here.
DATABASE_URL_UNPOOLED=postgres://user:password@direct-host/neondb?sslmode=require
RESUME_STORAGE_BACKEND=local
NEON_STORAGE_BUCKET=uploads
AWS_ENDPOINT_URL_S3=https://your-branch.storage.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret

CACHE_BACKEND=local
